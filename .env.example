# このファイルを .env にコピーして値を埋める（.env は git 管理外）
# cp .env.example .env

# ===== Meta (Facebook / Instagram) 広告 =====
# 取得方法: https://developers.facebook.com/ でアプリ作成 → Marketing API 追加
# システムユーザートークン（無期限）推奨。権限: ads_read, ads_management
META_ACCESS_TOKEN=
# 広告アカウントID（act_ プレフィックス付き。例: act_1234567890）
META_AD_ACCOUNT_ID=
# Graph API バージョン（省略可）
META_API_VERSION=v23.0

# ===== Google 広告 =====
# 取得方法: Google Ads 管理画面 → ツール → APIセンター で開発者トークン取得
# Google Cloud Console で OAuth クライアント（デスクトップアプリ）作成
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# scripts/generate_google_refresh_token.py で生成
GOOGLE_ADS_REFRESH_TOKEN=
# 操作対象の顧客ID（ハイフンなし10桁。例: 1234567890）
GOOGLE_ADS_CUSTOMER_ID=
# MCC（マネージャーアカウント）経由の場合のみ設定（ハイフンなし）
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ===== AWSから認証情報を取得する場合（上の個別キーは不要になる）=====
# Secrets Manager のシークレット名（値は上記キーをまとめたJSON）
ADS_AWS_SECRET_NAME=
# または SSM Parameter Store のパスプレフィックス（例: /ads/）
ADS_AWS_SSM_PREFIX=
# AWS自体の認証（IAMロールがあれば不要）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1
