{%- assign s = section.settings -%}
<section class="section section--tight{% if s.scheme == 'dark' %} section--dark{% elsif s.scheme == 'sand' %} section--sand{% endif %}">
  <div class="container container--narrow text-center store-entrance">
    {%- if s.number != blank -%}<p class="section-number reveal">{{ s.number }}</p>{%- endif -%}
    <p class="eyebrow mt-2 reveal">{{ s.eyebrow }}</p>
    <h2 class="h1 mt-3 reveal" data-delay="1">{{ s.title }}</h2>
    {%- if s.text != blank -%}<div class="body-copy mt-3 reveal" data-delay="2">{{ s.text }}</div>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <nav class="store-entrance__links reveal" data-delay="2" aria-label="{{ s.eyebrow }}">
        {%- for block in section.blocks -%}
          <a class="link-line" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
    {%- if s.button_label != blank -%}<div class="mt-4 reveal" data-delay="3"><a class="button button--outline" href="{{ s.button_link }}">{{ s.button_label }}</a></div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "オンラインストア入口",
  "settings": [
    { "type": "text", "id": "number", "label": "番号", "default": "(06)" },
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "Online Store" },
    { "type": "text", "id": "title", "label": "見出し", "default": "オンラインストア" },
    { "type": "richtext", "id": "text", "label": "本文", "default": "<p>雪山の機能性と、街でも着られるデザイン。PERMANENT UNIONの全ラインナップはオンラインストアでご覧いただけます。</p>" },
    { "type": "text", "id": "button_label", "label": "ボタン", "default": "Enter Online Store" },
    { "type": "url", "id": "button_link", "label": "ボタンリンク" },
    { "type": "select", "id": "scheme", "label": "配色", "options": [ { "value": "light", "label": "ライト" }, { "value": "sand", "label": "サンド" }, { "value": "dark", "label": "ダーク" } ], "default": "sand" }
  ],
  "blocks": [
    { "type": "link", "name": "リンク", "limit": 8, "settings": [
      { "type": "text", "id": "label", "label": "ラベル", "default": "Shell" },
      { "type": "url", "id": "link", "label": "リンク先" }
    ] }
  ],
  "presets": [{ "name": "オンラインストア入口", "blocks": [
    { "type": "link", "settings": { "label": "Shell" } },
    { "type": "link", "settings": { "label": "Tops" } },
    { "type": "link", "settings": { "label": "Bottoms" } },
    { "type": "link", "settings": { "label": "Accessories" } },
    { "type": "link", "settings": { "label": "All Items" } }
  ] }]
}
{% endschema %}
