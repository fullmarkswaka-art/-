{%- liquid
  assign s = section.settings
  assign tabs = linklists[s.tabs_menu]
  assign title = collection.title
  if collection.handle == 'all' or collection == blank
    assign title = s.all_title
  endif
  assign sub = collection.metafields.custom.subtitle | default: s.all_sub
-%}
<section class="lp container" data-header="dark">
  <div class="crumb"><a href="{{ routes.root_url }}">HOME</a> ／ <a href="{{ routes.all_products_collection_url }}">PRODUCTS</a>{% unless collection.handle == 'all' %} ／ {{ collection.title | upcase }}{% endunless %}</div>
  <div class="ptitle"><h1 class="ptitle__h">{{ title }}</h1><div class="ptitle__s">{{ sub }}</div></div>

  <div class="ctrl">
    <nav class="tabs" aria-label="{{ 'collections.general.categories' | t }}">
      {%- if tabs.links.size > 0 -%}
        {%- for link in tabs.links -%}
          {%- assign on = false -%}
          {%- if link.url == collection.url or link.url contains collection.handle and collection.handle != blank -%}{%- assign on = true -%}{%- endif -%}
          <a class="tab{% if on %} is-on{% endif %}" href="{{ link.url }}">{{ link.title | upcase }}</a>
        {%- endfor -%}
      {%- else -%}
        <a class="tab{% if collection.handle == 'all' %} is-on{% endif %}" href="{{ routes.all_products_collection_url }}">ALL</a>
        {%- for c in collections limit: 8 -%}{%- unless c.handle == 'all' or c.handle == 'frontpage' -%}<a class="tab{% if c.handle == collection.handle %} is-on{% endif %}" href="{{ c.url }}">{{ c.title | upcase }}</a>{%- endunless -%}{%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="ctrl__right">
      {%- if s.show_filters and collection.filters.size > 0 -%}
        <button class="sel" type="button" data-facets-toggle aria-expanded="false">{{ 'collections.general.filter' | t }}　＋</button>
      {%- endif -%}
      <label class="sel sel--sort">
        <span>{{ 'collections.general.sort' | t }}：</span>
        <select data-sort-by aria-label="{{ 'collections.general.sort' | t }}">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
        <span class="sel__caret">▾</span>
      </label>
    </div>
  </div>
  <div class="ctrl__line"></div>

  {%- if s.show_filters and collection.filters.size > 0 -%}
    <form class="facets" data-facet-form>
      {%- for filter in collection.filters -%}
        <fieldset class="facet">
          <legend class="lbl2">{{ filter.label }}</legend>
          {%- case filter.type -%}
            {%- when 'list' -%}
              <div class="facet__values">
                {%- for value in filter.values -%}
                  <label class="facet__v{% if value.count == 0 and value.active == false %} is-dis{% endif %}">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                    <span>{{ value.label }}</span><small>{{ value.count }}</small>
                  </label>
                {%- endfor -%}
              </div>
            {%- when 'price_range' -%}
              <div class="facet__price">
                <input type="number" name="{{ filter.min_value.param_name }}" placeholder="¥ 0" min="0" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}">
                <span>–</span>
                <input type="number" name="{{ filter.max_value.param_name }}" placeholder="¥ {{ filter.range_max | money_without_currency }}" min="0" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}">
              </div>
          {%- endcase -%}
        </fieldset>
      {%- endfor -%}
      <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
      <div class="facets__actions"><button class="btn-o btn-o--s" type="submit">{{ 'collections.general.apply' | t }}</button><a class="facets__clear" href="{{ collection.url }}">{{ 'collections.general.clear' | t }}</a></div>
    </form>
  {%- endif -%}

  {%- paginate collection.products by s.per_page -%}
    <div class="count">{{ 'collections.general.items_count' | t: count: collection.products_count }}</div>
    {%- if collection.products.size > 0 -%}
      <div class="cards cards--4">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="cart-empty cart-empty--page"><p>{{ 'collections.general.no_matches' | t }}</p></div>
    {%- endif -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "商品一覧",
  "settings": [
    { "type": "text", "id": "all_title", "label": "全商品の見出し", "default": "All Products" },
    { "type": "text", "id": "all_sub", "label": "和文小見出し（初期値）", "default": "商品一覧", "info": "コレクションごとに変えるにはメタフィールド custom.subtitle を使用" },
    { "type": "link_list", "id": "tabs_menu", "label": "カテゴリタブのメニュー", "default": "main-menu", "info": "ALL / OUTERWEAR / TOPS … の並び" },
    { "type": "checkbox", "id": "show_filters", "label": "絞り込み（FILTER）を表示", "default": true, "info": "Shopify の検索と絞り込み（Search & Discovery アプリ）で設定したフィルター" },
    { "type": "range", "id": "per_page", "label": "1ページの表示数", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
