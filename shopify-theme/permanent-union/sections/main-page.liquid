<section class="lp container" data-header="dark">
  <div class="crumb"><a href="{{ routes.root_url }}">HOME</a> ／ {{ page.title | upcase }}</div>
  <div class="ptitle"><h1 class="ptitle__h">{{ section.settings.heading | default: page.title }}</h1>{% if section.settings.sub != blank %}<div class="ptitle__s">{{ section.settings.sub }}</div>{% endif %}</div>
  <div class="art"><div class="rte art__body">{{ page.content }}</div></div>
</section>
{% schema %}
{
  "name": "ページ本文",
  "settings": [
    { "type": "text", "id": "heading", "label": "英字見出し（上書き）" },
    { "type": "text", "id": "sub", "label": "和文小見出し" }
  ]
}
{% endschema %}
