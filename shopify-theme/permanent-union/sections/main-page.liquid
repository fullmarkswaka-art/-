<section class="container container--narrow section">
  {%- if section.settings.show_title -%}
    <div class="page-title" style="padding-top:0">
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
      <h1 class="display mt-2 reveal" data-delay="1">{{ page.title }}</h1>
    </div>
  {%- endif -%}
  <div class="rte body-copy reveal" data-delay="2">{{ page.content }}</div>
</section>
{% schema %}
{
  "name": "ページ本文",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "タイトルを表示", "default": true },
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "Information" }
  ]
}
{% endschema %}
