<section class="lp container" data-header="dark">
  <div class="crumb"><a href="{{ routes.root_url }}">HOME</a> ／ COLLECTIONS</div>
  <div class="ptitle"><h1 class="ptitle__h">{{ 'collections.general.title' | t }}</h1><div class="ptitle__s">{{ section.settings.sub }}</div></div>
  <div class="cats cats--list">
    {%- for c in collections -%}
      {%- unless c.handle == 'frontpage' -%}
        <a class="cat" href="{{ c.url }}">
          <div class="cat__media">{% if c.image %}{{ c.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: c.title, class: 'cat__img' }}{% elsif c.products.first.featured_media %}{{ c.products.first.featured_media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: c.title, class: 'cat__img' }}{% endif %}<div class="cat__dim"></div></div>
          <div class="cat__text"><div class="cat__t">{{ c.title }}</div><div class="cat__s">{{ c.products_count }} items</div></div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "コレクション一覧", "settings": [ { "type": "text", "id": "sub", "label": "和文小見出し", "default": "カテゴリ一覧" } ] }
{% endschema %}
