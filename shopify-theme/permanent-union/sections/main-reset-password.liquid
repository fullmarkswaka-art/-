<section class="container section"><div class="customer__box" style="max-width:520px">
  <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
  {% form 'reset_customer_password', class: 'form' %}
    {%- if form.errors -%}<div class="form__errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input type="password" id="ResetPassword" name="customer[password]" required></div>
    <div class="field"><label for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input type="password" id="ResetConfirm" name="customer[password_confirmation]" required></div>
    <div><button type="submit" class="button">{{ 'customer.reset.submit' | t }}</button></div>
  {% endform %}
</div></section>
{% schema %}{ "name": "パスワード再設定", "settings": [] }{% endschema %}
