<section class="container container--wide section">
  <div class="page-title" style="padding-top:0">
    <p class="eyebrow">Search</p>
    <form action="{{ routes.search_url }}" method="get" class="search-form mt-3" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="{{ 'general.search.search' | t }}">{% render 'icon', name: 'search' %}</button>
    </form>
    {%- if search.performed -%}<p class="muted mt-3">{{ 'general.search.results' | t: count: search.results_count, terms: search.terms }}</p>{%- endif -%}
  </div>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count > 0 -%}
        <div class="product-grid" style="--cols: 4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'product-card', product: item, index: forloop.index0 %}
            {%- else -%}<a class="journal-card" href="{{ item.url }}"><div class="journal-card__meta"><span>{{ item.object_type }}</span></div><h3 class="journal-card__title">{{ item.title }}</h3></a>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="empty-state"><p class="lead">{{ 'general.search.no_results' | t }}</p></div>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>
{% schema %}
{ "name": "検索", "settings": [] }
{% endschema %}
