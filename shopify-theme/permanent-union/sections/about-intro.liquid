{%- liquid
  assign s = section.settings
  assign body = s.text
  if s.use_page_content and page.content != blank
    assign body = page.content
  endif
-%}
<section class="lp lp--about container{% if s.reverse %} about--rev{% endif %}" data-header="dark">
  <div class="about">
    <div class="about__text">
      {%- if s.label != blank -%}<div class="lbl2">{{ s.label }}</div>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="about__h">{{ s.heading }}</h2>{%- endif -%}
      <div class="about__body rte">{{ body }}</div>
      {%- if section.blocks.size > 0 -%}
        <div class="about__links">
          {%- for block in section.blocks -%}<a class="more" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}　→</a>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="about__media" style="--pos:{{ s.focal_x }}% {{ s.focal_y }}%">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 900px) 100vw, 45vw', widths: '600, 900, 1400', alt: '', class: 'cover-img' }}
      {%- else -%}
        <img class="cover-img" src="{{ s.fallback | default: 'pu-story-05.jpg' | asset_url }}" alt="" loading="lazy" width="2000" height="1333">
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "テキスト＋写真（About）",
  "settings": [
    { "type": "text", "id": "label", "label": "ラベル", "default": "SINCE 2013" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "自然は、素晴らしい。" },
    { "type": "richtext", "id": "text", "label": "本文", "default": "<p>森に抱かれ、山で遊ぶ時間は、私たちにとって至福のものです。だからこそ、自分らしいウェアを身に纏いたいのです。〜山にいるときこそ最高であれ〜 をコンセプトに、2013年に誕生したスノーライフスタイルブランド。山岳ガイドやスキーヤー、スノーボーダーの意見をもとに、雪山に対応する機能性と、街でも違和感なく着ることができるデザインを兼ね備えたプロダクトを届けています。</p>" },
    { "type": "checkbox", "id": "use_page_content", "label": "ページ本文（管理画面のページ）を使う", "default": false, "info": "オンにすると上の本文の代わりにページの本文を表示" },
    { "type": "image_picker", "id": "image", "label": "写真" },
    { "type": "text", "id": "fallback", "label": "テーマ同梱の仮写真ファイル名", "default": "pu-story-05.jpg" },
    { "type": "range", "id": "focal_x", "label": "トリミング位置 横", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "トリミング位置 縦", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "checkbox", "id": "reverse", "label": "写真を左に", "default": false }
  ],
  "blocks": [
    { "type": "link", "name": "リンク", "limit": 3, "settings": [
      { "type": "text", "id": "label", "label": "文言", "default": "PRODUCTS" },
      { "type": "url", "id": "link", "label": "リンク先" }
    ] }
  ],
  "presets": [{ "name": "テキスト＋写真（About）", "blocks": [ { "type": "link", "settings": { "label": "PRODUCTS", "link": "/collections/all" } }, { "type": "link", "settings": { "label": "RIDERS", "link": "/pages/riders" } } ] }]
}
{% endschema %}
