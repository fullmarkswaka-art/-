<section class="lp container" data-header="dark">
  <div class="crumb"><a href="{{ routes.root_url }}">HOME</a> ／ CART</div>
  <div class="ptitle"><h1 class="ptitle__h">Cart</h1><div class="ptitle__s">{{ 'sections.cart.title' | t }}（{{ cart.item_count }}）</div></div>
  {%- if cart.item_count == 0 -%}
    <div class="cart-empty cart-empty--page">
      <p>{{ 'sections.cart.empty' | t }}</p>
      <a class="more" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}　→</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page">
      <div class="cart-page__lines">
        {%- for item in cart.items -%}
          {% render 'cart-line', item: item, line: forloop.index %}
        {%- endfor -%}
        {%- if section.settings.show_note -%}
          <div class="cart-page__note">
            <label class="lbl2" for="CartNote">{{ 'sections.cart.note' | t }}</label>
            <textarea id="CartNote" name="note" class="field__input">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>
      <aside class="cart-page__summary">
        <div class="cart-total"><span>{{ 'sections.cart.subtotal' | t }}</span><b>{{ cart.items_subtotal_price | money }}</b></div>
        {%- for d in cart.cart_level_discount_applications -%}
          <div class="cart-total cart-total--sub"><span>{{ d.title }}</span><b>-{{ d.total_allocated_amount | money }}</b></div>
        {%- endfor -%}
        <p class="cart-note">{{ 'sections.cart.taxes_and_shipping' | t }}{% if section.settings.shipping_note != blank %}<br>{{ section.settings.shipping_note }}{% endif %}</p>
        <button type="submit" name="checkout" class="btn-d">{{ 'sections.cart.checkout' | t }}</button>
        {%- if section.settings.show_dynamic -%}<div class="mt-2">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        <a class="cart-continue" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
      </aside>
    </form>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "カートページ",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "備考欄を表示", "default": true },
    { "type": "checkbox", "id": "show_dynamic", "label": "追加のチェックアウトボタンを表示", "default": false },
    { "type": "text", "id": "shipping_note", "label": "送料に関する注記", "default": "送料・お届け日数はご利用ガイドをご確認ください（条件は仮）" }
  ]
}
{% endschema %}
