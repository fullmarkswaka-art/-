<section class="container section">
  <div class="page-title" style="padding-top:0"><p class="eyebrow">Addresses</p><h1 class="display mt-2">{{ 'customer.addresses.title' | t }}</h1><a class="link-line mt-2" href="{{ routes.account_url }}">{{ 'customer.account.back' | t }}</a></div>
  <div class="customer">
    <div class="customer__box">
      <h2 class="h3">{{ 'customer.addresses.add' | t }}</h2>
      {% form 'customer_address', customer.new_address, class: 'form mt-3' %}
        <div class="field"><label for="AddrLast">{{ 'customer.last_name' | t }}</label><input type="text" id="AddrLast" name="address[last_name]" value="{{ form.last_name }}"></div>
        <div class="field"><label for="AddrFirst">{{ 'customer.first_name' | t }}</label><input type="text" id="AddrFirst" name="address[first_name]" value="{{ form.first_name }}"></div>
        <div class="field"><label for="AddrZip">{{ 'customer.addresses.zip' | t }}</label><input type="text" id="AddrZip" name="address[zip]" value="{{ form.zip }}"></div>
        <div class="field"><label for="AddrCountry">{{ 'customer.addresses.country' | t }}</label><select id="AddrCountry" name="address[country]" data-default="{{ form.country }}">{{ country_option_tags }}</select></div>
        <div class="field"><label for="AddrProvince">{{ 'customer.addresses.province' | t }}</label><input type="text" id="AddrProvince" name="address[province]" value="{{ form.province }}"></div>
        <div class="field"><label for="AddrCity">{{ 'customer.addresses.city' | t }}</label><input type="text" id="AddrCity" name="address[city]" value="{{ form.city }}"></div>
        <div class="field"><label for="Addr1">{{ 'customer.addresses.address1' | t }}</label><input type="text" id="Addr1" name="address[address1]" value="{{ form.address1 }}"></div>
        <div class="field"><label for="Addr2">{{ 'customer.addresses.address2' | t }}</label><input type="text" id="Addr2" name="address[address2]" value="{{ form.address2 }}"></div>
        <div class="field"><label for="AddrPhone">{{ 'customer.addresses.phone' | t }}</label><input type="tel" id="AddrPhone" name="address[phone]" value="{{ form.phone }}"></div>
        <div class="field"><label><input type="checkbox" name="address[default]"> {{ 'customer.addresses.set_default' | t }}</label></div>
        <div><button type="submit" class="button">{{ 'customer.addresses.add' | t }}</button></div>
      {% endform %}
    </div>
    <div class="customer__box">
      <h2 class="h3">{{ 'customer.addresses.saved' | t }}</h2>
      {%- for address in customer.addresses -%}
        <div class="address-card mt-3">
          {%- if address == customer.default_address -%}<p class="eyebrow">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
          {{ address | format_address }}
          <div class="address-card__actions">
            <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" onsubmit="return confirm('{{ 'customer.addresses.delete_confirm' | t }}')"><input type="hidden" name="_method" value="delete"><button type="submit">{{ 'customer.addresses.delete' | t }}</button></form>
          </div>
        </div>
      {%- else -%}<p class="body-copy">{{ 'customer.addresses.none' | t }}</p>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}{ "name": "住所", "settings": [] }{% endschema %}
