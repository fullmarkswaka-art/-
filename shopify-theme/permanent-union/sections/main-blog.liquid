<section class="container container--wide section">
  <div class="page-title" style="padding-top:0"><p class="eyebrow reveal">Journal</p><h1 class="display mt-2 reveal" data-delay="1">{{ blog.title }}</h1></div>
  {%- paginate blog.articles by 12 -%}
    <div class="journal">
      {%- for article in blog.articles -%}
        <a class="journal-card reveal" data-delay="{{ forloop.index0 | modulo: 3 }}" href="{{ article.url }}">
          <div class="media journal-card__media">{%- if article.image -%}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'cover-media' }}{%- endif -%}</div>
          <div class="journal-card__meta"><span>{{ article.published_at | date: '%Y.%m.%d' }}</span>{%- if article.tags.size > 0 -%}<span>{{ article.tags.first }}</span>{%- endif -%}</div>
          <h2 class="journal-card__title">{{ article.title }}</h2>
        </a>
      {%- else -%}
        <p class="lead">{{ 'blogs.empty' | t }}</p>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "ブログ一覧", "settings": [] }
{% endschema %}
