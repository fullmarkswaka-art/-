{%- liquid
  comment
    ヘッダー: 左 SHOP（カート）／中央ロゴ／右 MENU（全画面メニュー）
    TOP では写真の上に重なるため、各セクションの data-header="light|dark" に合わせて JS が色を切り替える
  endcomment
  assign mode = 'dark'
  if request.page_type == 'index'
    assign mode = section.settings.home_mode
  elsif template.suffix == 'about'
    assign mode = 'light'
  endif
  assign shop_menu = linklists[section.settings.shop_menu]
  assign info_menu = linklists[section.settings.info_menu]
-%}
<header class="hd hd--{{ mode }}{% if request.page_type == 'index' %} hd--home{% endif %}" data-header data-default-mode="{{ mode }}">
  <button class="hd__ic hd__shop" type="button" {% if settings.cart_type == 'drawer' %}data-drawer-open="CartDrawer"{% else %}onclick="location.href='{{ routes.cart_url }}'"{% endif %} aria-label="{{ 'sections.cart.title' | t }}">
    {% render 'icon', name: 'bag' %}<span class="hd__ic-label">{{ section.settings.shop_label }}</span>
    <span class="hd__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
  </button>
  <a class="hd__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    {% render 'logo', color: 'brown', class: 'hd__logo-img hd__logo-img--brown', width: 480 %}
    {% render 'logo', color: 'white', class: 'hd__logo-img hd__logo-img--white', width: 480 %}
  </a>
  <button class="hd__ic hd__menu" type="button" data-drawer-open="MenuDrawer" aria-label="{{ 'accessibility.open_menu' | t }}" aria-expanded="false" aria-controls="MenuDrawer">
    {% render 'icon', name: 'burger' %}<span class="hd__ic-label">{{ section.settings.menu_label }}</span>
  </button>
</header>

<div id="MenuDrawer" class="menu" aria-hidden="true" role="dialog" aria-label="{{ 'accessibility.main_menu' | t }}">
  <div class="menu__inner">
    <div class="menu__head">
      <a class="menu__logo" href="{{ routes.root_url }}">{% render 'logo', color: 'white', class: 'menu__logo-img', width: 400 %}</a>
      <button class="menu__close" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}"><span class="menu__x">×</span><span>CLOSE</span></button>
    </div>
    <nav class="menu__body">
      <div class="menu__group">
        <div class="menu__label">{{ section.settings.shop_heading }}</div>
        <ul class="menu__shop">
          {%- if shop_menu.links.size > 0 -%}
            {%- for link in shop_menu.links -%}<li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>{%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
            {%- for c in collections limit: 6 -%}{%- unless c.handle == 'all' or c.handle == 'frontpage' -%}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{%- endunless -%}{%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
      <div class="rope rope--h rope--white menu__rope"></div>
      <div class="menu__group">
        <div class="menu__label">{{ section.settings.info_heading }}</div>
        <ul class="menu__info">
          {%- for link in info_menu.links -%}<li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>{%- endfor -%}
          {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></li>{%- endif -%}
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram　↗</a></li>{%- endif -%}
        </ul>
      </div>
    </nav>
    {%- if section.settings.show_search -%}
      <form class="menu__search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
        <button type="submit" aria-label="{{ 'general.search.search' | t }}">{% render 'icon', name: 'search' %}</button>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ヘッダー",
  "settings": [
    { "type": "paragraph", "content": "左：SHOP（カートを開く）／中央：ロゴ／右：MENU（全画面メニュー）。ロゴ画像はテーマ設定 > ロゴで変更します。" },
    { "type": "text", "id": "shop_label", "label": "左アイコンのラベル", "default": "SHOP" },
    { "type": "text", "id": "menu_label", "label": "右アイコンのラベル", "default": "MENU" },
    { "type": "select", "id": "home_mode", "label": "トップページ最上部の色", "options": [ { "value": "dark", "label": "ブラウン（明るい写真の上）" }, { "value": "light", "label": "白（暗い写真の上）" } ], "default": "dark", "info": "スクロール後は各セクションの設定に合わせて自動で切り替わります" },
    { "type": "header", "content": "全画面メニュー" },
    { "type": "text", "id": "shop_heading", "label": "SHOP の見出し", "default": "SHOP" },
    { "type": "link_list", "id": "shop_menu", "label": "SHOP メニュー", "default": "main-menu", "info": "All Products / Outerwear / Tops / Bottoms / Accessories など" },
    { "type": "text", "id": "info_heading", "label": "INFORMATION の見出し", "default": "INFORMATION" },
    { "type": "link_list", "id": "info_menu", "label": "INFORMATION メニュー", "default": "footer", "info": "About Us / Riders / Journal / Shop List / ご利用ガイド / お問い合わせ など" },
    { "type": "checkbox", "id": "show_search", "label": "メニュー内に検索欄を表示", "default": true }
  ]
}
{% endschema %}
