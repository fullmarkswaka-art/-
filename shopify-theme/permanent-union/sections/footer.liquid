{%- liquid
  assign shop_menu = linklists[section.settings.shop_menu]
  assign info_menu = linklists[section.settings.info_menu]
-%}
<footer class="footer" data-header="light">
  <div class="container">
    <div class="rope rope--h rope--white footer__rope"></div>
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__logo" href="{{ routes.root_url }}">{% render 'logo', color: 'white', class: 'footer__logo-img', width: 400 %}</a>
        {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
      </div>
      <div class="footer__col">
        <div class="footer__label">{{ section.settings.shop_heading }}</div>
        <ul>
          {%- for link in shop_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        </ul>
      </div>
      <div class="footer__col footer__col--info">
        <div class="footer__label">{{ section.settings.info_heading }}</div>
        <ul>
          {%- for link in info_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        </ul>
      </div>
      <div class="footer__col footer__col--news">
        {%- if section.settings.show_newsletter -%}
          <div class="footer__label">{{ section.settings.newsletter_heading }}</div>
          {% form 'customer', class: 'footer__news' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="footer__news-msg">{{ 'general.newsletter.success' | t }}</p>
            {%- else -%}
              <div class="footer__news-row">
                <input type="email" name="contact[email]" required placeholder="{{ 'general.newsletter.placeholder' | t }}" aria-label="{{ 'general.newsletter.placeholder' | t }}">
                <button type="submit" aria-label="{{ 'general.newsletter.submit' | t }}">→</button>
              </div>
            {%- endif -%}
          {% endform %}
        {%- endif -%}
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">INSTAGRAM　↗</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">FACEBOOK　↗</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">YOUTUBE　↗</a>{%- endif -%}
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}</span>
      <span class="footer__policies">
        {%- for policy in shop.policies -%}
          {%- if policy.title != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "フッター",
  "settings": [
    { "type": "text", "id": "tagline", "label": "タグライン", "default": "山へ　街へ　その先へ" },
    { "type": "text", "id": "shop_heading", "label": "SHOP の見出し", "default": "SHOP" },
    { "type": "link_list", "id": "shop_menu", "label": "SHOP メニュー", "default": "main-menu" },
    { "type": "text", "id": "info_heading", "label": "INFORMATION の見出し", "default": "INFORMATION" },
    { "type": "link_list", "id": "info_menu", "label": "INFORMATION メニュー", "default": "footer" },
    { "type": "checkbox", "id": "show_newsletter", "label": "ニュースレター登録を表示", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "ニュースレターの見出し", "default": "NEWSLETTER" },
    { "type": "text", "id": "copyright", "label": "コピーライト表記", "default": "PERMANENT UNION" },
    { "type": "paragraph", "content": "プライバシーポリシー・利用規約は 設定 > ポリシー に登録すると自動で表示されます。" }
  ]
}
{% endschema %}
