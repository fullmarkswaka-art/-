<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          <a class="footer__logo" href="{{ routes.root_url }}">{{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}</a>
        {%- else -%}
          <p class="footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
        </div>
        {%- if section.settings.show_newsletter -%}
          <div class="mt-4">
            <p class="eyebrow" style="color:rgba(255,255,255,.55)">{{ section.settings.newsletter_title }}</p>
            {% form 'customer', class: 'footer__form-wrap' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="newsletter__msg">{{ 'general.newsletter.success' | t }}</p>
              {%- else -%}
                <div class="footer__form">
                  <input type="email" name="contact[email]" required placeholder="{{ 'general.newsletter.placeholder' | t }}" aria-label="{{ 'general.newsletter.placeholder' | t }}">
                  <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
                </div>
              {%- endif -%}
            {% endform %}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}</p>
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment">
          {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "フッター",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "ロゴ", "info": "白抜きで表示されます" },
    { "type": "text", "id": "tagline", "label": "タグライン", "default": "Be Awesome In The Mountain — 山にいるときこそ最高であれ" },
    { "type": "checkbox", "id": "show_newsletter", "label": "ニュースレター登録を表示", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "ニュースレター見出し", "default": "Newsletter" },
    { "type": "text", "id": "copyright", "label": "コピーライト表記", "default": "PERMANENT UNION / FULLMARKS ALL RIGHTS RESERVED." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "決済アイコンを表示", "default": true }
  ],
  "blocks": [
    {
      "type": "menu", "name": "リンク列", "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "見出し", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "メニュー", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "title": "Shop", "menu": "main-menu" } },
      { "type": "menu", "settings": { "title": "Support", "menu": "footer" } }
    ]
  }
}
{% endschema %}
