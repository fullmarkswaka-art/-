<section class="container section customer">
  <div class="customer__box">
    <h2 class="h2">{{ 'customer.login.title' | t }}</h2>
    {% form 'customer_login', class: 'form' %}
      {%- if form.errors -%}<div class="form__errors">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="CustomerEmail">{{ 'customer.email' | t }}</label><input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="CustomerPassword">{{ 'customer.password' | t }}</label><input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required></div>
      <div><button type="submit" class="button">{{ 'customer.login.submit' | t }}</button></div>
      <div class="form__links"><a href="#recover">{{ 'customer.login.forgot' | t }}</a></div>
    {% endform %}
    <div id="recover" class="mt-6">
      <h3 class="h3">{{ 'customer.recover.title' | t }}</h3>
      {% form 'recover_customer_password', class: 'form mt-3' %}
        {%- if form.posted_successfully? -%}<p class="form__success">{{ 'customer.recover.success' | t }}</p>{%- endif -%}
        {%- if form.errors -%}<div class="form__errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label for="RecoverEmail">{{ 'customer.email' | t }}</label><input type="email" id="RecoverEmail" name="email" required></div>
        <div><button type="submit" class="button button--outline">{{ 'customer.recover.submit' | t }}</button></div>
      {% endform %}
    </div>
  </div>
  <div class="customer__box">
    <h2 class="h2">{{ 'customer.register.title' | t }}</h2>
    <p class="body-copy">{{ 'customer.register.text' | t }}</p>
    <a class="button button--outline mt-3" href="{{ routes.account_register_url }}">{{ 'customer.register.submit' | t }}</a>
  </div>
</section>
{% schema %}{ "name": "ログイン", "settings": [] }{% endschema %}
