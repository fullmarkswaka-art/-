{%- liquid
  assign s = section.settings
-%}
<section class="dark sec sec--riders" data-header="light">
  <div class="container riders">
    <div class="riders__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 900px) 100vw, 40vw', widths: '600, 900, 1400', alt: '', class: 'cover-img' }}
      {%- else -%}
        <img class="cover-img" src="{{ 'pu-riders.jpg' | asset_url }}" alt="" loading="lazy" width="1000" height="500">
      {%- endif -%}
    </div>
    <div class="riders__body">
      <div class="riders__head"><h2 class="sec-h sec-h--m sec-h--w">{{ s.heading }}</h2><span class="sec-s sec-s--w">{{ s.sub }}</span></div>
      <div class="rope rope--h rope--white riders__rope"></div>
      <div class="riders__grid">
        {%- for block in section.blocks -%}
          <div class="rider" {{ block.shopify_attributes }}>
            <div class="rider__row"><span class="rider__jp">{{ block.settings.name }}</span><span class="rider__role">{{ block.settings.role }}</span></div>
            <div class="rider__en">{{ block.settings.name_en }}</div>
          </div>
        {%- endfor -%}
      </div>
      {%- if s.link_label != blank -%}<a class="more more--w" href="{{ s.link | default: '/pages/riders' }}">{{ s.link_label }}　→</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Riders（TOP）",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Riders" },
    { "type": "text", "id": "sub", "label": "和文小見出し", "default": "フィールドの声から、生まれる。" },
    { "type": "image_picker", "id": "image", "label": "写真" },
    { "type": "text", "id": "link_label", "label": "リンク文言", "default": "MEET THE RIDERS" },
    { "type": "url", "id": "link", "label": "リンク先（Riders ページ）" }
  ],
  "blocks": [
    { "type": "rider", "name": "ライダー", "settings": [
      { "type": "text", "id": "name", "label": "名前", "default": "山内 一志" },
      { "type": "text", "id": "name_en", "label": "名前（英字）", "default": "Kazushi Yamauchi" },
      { "type": "text", "id": "role", "label": "種目", "default": "SNOWBOARDER" }
    ] }
  ],
  "presets": [{ "name": "Riders（TOP）", "blocks": [
    { "type": "rider", "settings": { "name": "山内 一志", "name_en": "Kazushi Yamauchi", "role": "SNOWBOARDER" } },
    { "type": "rider", "settings": { "name": "畔田 正志", "name_en": "Masashi Kuroda", "role": "SNOWBOARDER" } },
    { "type": "rider", "settings": { "name": "舎川 朋弘", "name_en": "Tomohiro Tonegawa", "role": "SKIER" } },
    { "type": "rider", "settings": { "name": "上村 愛子", "name_en": "Aiko Uemura", "role": "SKIER" } },
    { "type": "rider", "settings": { "name": "永島 秀之", "name_en": "Hideyuki Nagashima", "role": "TELEMARK SKIER" } },
    { "type": "rider", "settings": { "name": "立花 透", "name_en": "Toru Tachibana", "role": "SKIER" } },
    { "type": "rider", "settings": { "name": "石川 睦", "name_en": "Makoto Ishikawa", "role": "SKIER" } },
    { "type": "rider", "settings": { "name": "笹田 知里", "name_en": "Chisato Sasada", "role": "SKIER" } }
  ] }]
}
{% endschema %}
