{%- liquid
  comment
    Shop List: 日本地図（都道府県コード 1〜47）＋台湾。地図にカーソルを合わせる／タップで店舗カード。地域タブで一覧を絞り込む。
    ブロック: region（地域の見出し）/ shop（店舗）。店舗の都道府県コードでピンを置く。
  endcomment
  assign s = section.settings
-%}
<section class="lp lp--shops container" data-header="dark" data-shoplist>
  <div class="crumb"><a href="{{ routes.root_url }}">HOME</a> ／ SHOP LIST</div>
  <div class="ptitle"><h1 class="ptitle__h">{{ s.heading | default: page.title }}</h1><div class="ptitle__s">{{ s.sub }}</div></div>

  <nav class="tabs tabs--regions" aria-label="{{ 'general.shoplist.regions' | t }}">
    <button class="tab is-on" type="button" data-region="all">ALL</button>
    {%- for block in section.blocks -%}
      {%- if block.type == 'region' -%}<button class="tab" type="button" data-region="{{ block.id }}">{{ block.settings.title }}</button>{%- endif -%}
    {%- endfor -%}
  </nav>

  <div class="shops">
    <div class="shops__map">
      <div class="mapwrap" data-map>
        {% render 'map-japan' %}
        {%- assign region = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'region' -%}{%- assign region = block.id -%}{%- continue -%}{%- endif -%}
          {%- assign b = block.settings -%}
          {%- if b.pref != blank and b.pref != "none" -%}
            <button type="button" class="pin" data-pin="{{ b.pref }}" data-shop="{{ block.id }}" data-region="{{ region }}" aria-label="{{ b.name }}"></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="shopcard" data-shopcard hidden>
        <div class="shopcard__ph" data-card-photo></div>
        <div class="shopcard__r" data-card-region></div>
        <div class="shopcard__n" data-card-name></div>
        <div class="shopcard__m" data-card-meta></div>
        <div class="shopcard__l" data-card-links></div>
      </div>
      {%- if s.taiwan_message != blank -%}
        <div class="shops__tw"><span class="flag" aria-hidden="true"></span>{{ s.taiwan_message }}</div>
      {%- endif -%}
    </div>

    <div class="shops__list" data-shop-list>
      {%- assign region = '' -%}
      {%- assign region_title = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'region' -%}
          {%- assign region = block.id -%}
          {%- assign region_title = block.settings.title -%}
          <div class="region" data-region-head="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.title }}　{{ block.settings.sub }}{% if block.settings.flag %}　<span class="flag" aria-hidden="true"></span>{% endif %}</div>
        {%- else -%}
          {%- assign b = block.settings -%}
          <div class="shoprow" data-shop="{{ block.id }}" data-region="{{ region }}" data-pref="{{ b.pref }}" {{ block.shopify_attributes }}
               data-name="{{ b.name | escape }}" data-area="{{ region_title | escape }}" data-address="{{ b.address | escape }}" data-tel="{{ b.tel | escape }}" data-hours="{{ b.hours | escape }}"
               data-map="{{ b.map_url }}" data-web="{{ b.url }}" {% if b.image != blank %}data-photo="{{ b.image | image_url: width: 600 }}"{% endif %}>
            <span class="shoprow__n">{{ b.name }}</span>
            <span class="shoprow__m">{{ b.address }}{% if b.tel != blank %} ／ {{ b.tel }}{% endif %}{% if b.hours != blank %}<br>{{ b.hours }}{% endif %}</span>
            <span class="shoprow__l">
              {%- if b.map_url != blank -%}<a href="{{ b.map_url }}" target="_blank" rel="noopener">MAP</a>{%- endif -%}
              {%- if b.url != blank -%}<a href="{{ b.url }}" target="_blank" rel="noopener">WEB</a>{%- endif -%}
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.blocks.size == 0 -%}<p class="pd2__pending">{{ 'general.shoplist.pending' | t }}</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop List（地図）",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Shop List" },
    { "type": "text", "id": "sub", "label": "和文小見出し", "default": "取扱店舗" },
    { "type": "textarea", "id": "taiwan_message", "label": "台湾についてのメッセージ", "info": "国旗の横に表示（文言はブランド側で支給）" },
    { "type": "paragraph", "content": "ブロックは「地域」→ その地域の「店舗」の順に並べてください。店舗の都道府県を選ぶと地図にピンが付きます。" }
  ],
  "blocks": [
    { "type": "region", "name": "地域（見出し）", "settings": [
      { "type": "text", "id": "title", "label": "英字", "default": "NAGANO" },
      { "type": "text", "id": "sub", "label": "和文", "default": "長野" },
      { "type": "checkbox", "id": "flag", "label": "台湾の国旗を表示", "default": false }
    ] },
    { "type": "shop", "name": "店舗", "settings": [
      { "type": "text", "id": "name", "label": "店舗名", "default": "店舗名" },
      { "type": "select", "id": "pref", "label": "都道府県（地図のピン）", "default": "20", "options": [
        { "value": "none", "label": "ピンなし" }, { "value": "1", "label": "北海道" }, { "value": "2", "label": "青森" }, { "value": "3", "label": "岩手" }, { "value": "4", "label": "宮城" }, { "value": "5", "label": "秋田" }, { "value": "6", "label": "山形" }, { "value": "7", "label": "福島" },
        { "value": "8", "label": "茨城" }, { "value": "9", "label": "栃木" }, { "value": "10", "label": "群馬" }, { "value": "11", "label": "埼玉" }, { "value": "12", "label": "千葉" }, { "value": "13", "label": "東京" }, { "value": "14", "label": "神奈川" },
        { "value": "15", "label": "新潟" }, { "value": "16", "label": "富山" }, { "value": "17", "label": "石川" }, { "value": "18", "label": "福井" }, { "value": "19", "label": "山梨" }, { "value": "20", "label": "長野" }, { "value": "21", "label": "岐阜" }, { "value": "22", "label": "静岡" }, { "value": "23", "label": "愛知" },
        { "value": "24", "label": "三重" }, { "value": "25", "label": "滋賀" }, { "value": "26", "label": "京都" }, { "value": "27", "label": "大阪" }, { "value": "28", "label": "兵庫" }, { "value": "29", "label": "奈良" }, { "value": "30", "label": "和歌山" },
        { "value": "31", "label": "鳥取" }, { "value": "32", "label": "島根" }, { "value": "33", "label": "岡山" }, { "value": "34", "label": "広島" }, { "value": "35", "label": "山口" }, { "value": "36", "label": "徳島" }, { "value": "37", "label": "香川" }, { "value": "38", "label": "愛媛" }, { "value": "39", "label": "高知" },
        { "value": "40", "label": "福岡" }, { "value": "41", "label": "佐賀" }, { "value": "42", "label": "長崎" }, { "value": "43", "label": "熊本" }, { "value": "44", "label": "大分" }, { "value": "45", "label": "宮崎" }, { "value": "46", "label": "鹿児島" }, { "value": "47", "label": "沖縄" }, { "value": "tw", "label": "台湾" }
      ] },
      { "type": "text", "id": "address", "label": "住所" },
      { "type": "text", "id": "tel", "label": "電話番号" },
      { "type": "text", "id": "hours", "label": "営業時間・定休日" },
      { "type": "url", "id": "map_url", "label": "Google マップのリンク" },
      { "type": "url", "id": "url", "label": "WEB サイト" },
      { "type": "image_picker", "id": "image", "label": "店舗写真（任意）" }
    ] }
  ],
  "presets": [{ "name": "Shop List（地図）", "blocks": [
    { "type": "region", "settings": { "title": "NAGANO", "sub": "長野" } },
    { "type": "shop", "settings": { "name": "FULLMARKS STORE", "pref": "20", "address": "長野県松本市", "url": "https://www.fullmarksstore.jp/" } },
    { "type": "region", "settings": { "title": "TAIWAN", "sub": "台湾", "flag": true } },
    { "type": "shop", "settings": { "name": "店舗名（仮）", "pref": "tw", "address": "台北市" } }
  ] }]
}
{% endschema %}
