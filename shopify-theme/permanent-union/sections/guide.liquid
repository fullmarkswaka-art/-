{%- liquid
  # ご利用ガイド・FAQ: 左に目次、右に本文。FAQ は開閉式。
  assign s = section.settings
-%}
<section class="lp container" data-header="dark" data-guide>
  <div class="crumb"><a href="{{ routes.root_url }}">HOME</a> ／ GUIDE</div>
  <div class="ptitle"><h1 class="ptitle__h">{{ s.heading | default: page.title }}</h1><div class="ptitle__s">{{ s.sub }}</div></div>
  <div class="guide">
    <nav class="guide__toc" aria-label="{{ 'general.guide.toc' | t }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'section' -%}<a href="#g-{{ block.id }}" data-toc>{{ block.settings.title }}</a>{%- endif -%}
      {%- endfor -%}
      {%- assign has_faq = false -%}
      {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign has_faq = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_faq -%}<a href="#g-faq" data-toc>{{ s.faq_heading }}</a>{%- endif -%}
    </nav>
    <div class="guide__body">
      {%- for block in section.blocks -%}
        {%- if block.type == 'section' -%}
          <div class="guide__sec" id="g-{{ block.id }}" {{ block.shopify_attributes }}>
            <h2 class="guide__h">{{ block.settings.title }}</h2>
            <div class="rte guide__t">{% if block.settings.content != blank %}{{ block.settings.content }}{% else %}<p class="is-pending">{{ 'general.guide.pending' | t }}</p>{% endif %}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if has_faq -%}
        <div class="guide__sec" id="g-faq">
          <h2 class="guide__h">{{ s.faq_heading }}</h2>
          <div class="faqs">
            {%- for block in section.blocks -%}
              {%- if block.type == 'faq' -%}
                <details class="faq" {% if forloop.first and s.open_first %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary><span>Q. {{ block.settings.q }}</span><b aria-hidden="true"></b></summary>
                  <div class="faq__a rte">{% if block.settings.a != blank %}{{ block.settings.a }}{% else %}<p class="is-pending">A. {{ 'general.guide.pending' | t }}</p>{% endif %}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      {%- if page.content != blank and s.show_page_content -%}<div class="rte guide__t guide__page">{{ page.content }}</div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ご利用ガイド・FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Guide ／ FAQ" },
    { "type": "text", "id": "sub", "label": "和文小見出し", "default": "ご利用ガイド・よくあるご質問" },
    { "type": "text", "id": "faq_heading", "label": "FAQ の見出し", "default": "よくあるご質問" },
    { "type": "checkbox", "id": "open_first", "label": "最初の質問を開いた状態にする", "default": true },
    { "type": "checkbox", "id": "show_page_content", "label": "ページ本文も表示する", "default": false }
  ],
  "blocks": [
    { "type": "section", "name": "項目", "settings": [
      { "type": "text", "id": "title", "label": "見出し", "default": "ご注文について" },
      { "type": "richtext", "id": "content", "label": "本文" }
    ] },
    { "type": "faq", "name": "質問", "settings": [
      { "type": "text", "id": "q", "label": "質問", "default": "サイズに迷ったときはどうすればいいですか？" },
      { "type": "richtext", "id": "a", "label": "回答" }
    ] }
  ],
  "presets": [{ "name": "ご利用ガイド・FAQ", "blocks": [
    { "type": "section", "settings": { "title": "ご注文について" } },
    { "type": "section", "settings": { "title": "お支払い方法" } },
    { "type": "section", "settings": { "title": "配送・送料" } },
    { "type": "section", "settings": { "title": "返品・交換" } },
    { "type": "section", "settings": { "title": "会員登録・ポイント" } },
    { "type": "faq", "settings": { "q": "サイズに迷ったときはどうすればいいですか？" } },
    { "type": "faq", "settings": { "q": "在庫切れの商品は再入荷しますか？" } },
    { "type": "faq", "settings": { "q": "店舗の在庫はオンラインで確認できますか？" } },
    { "type": "faq", "settings": { "q": "修理の受付はしていますか？" } },
    { "type": "faq", "settings": { "q": "海外への発送はできますか？" } }
  ] }]
}
{% endschema %}
