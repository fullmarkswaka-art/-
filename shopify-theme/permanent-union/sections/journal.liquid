{%- assign s = section.settings -%}
{%- assign blog = blogs[s.blog] -%}
<section class="section">
  <div class="container container--wide">
    <div class="section-head reveal">
      <div class="section-head__title">
        <span class="section-number">{{ s.number }}</span>
        <div><p class="eyebrow">{{ s.eyebrow }}</p><h2 class="h1 mt-1">{{ s.title }}</h2></div>
      </div>
      {%- if blog != blank -%}<a class="link-line section-head__link" href="{{ blog.url }}">{{ s.link_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
    <div class="journal">
      {%- if blog != blank and blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: s.limit -%}
          <a class="journal-card reveal" data-delay="{{ forloop.index0 }}" href="{{ article.url }}">
            <div class="media journal-card__media">
              {%- if article.image -%}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(max-width: 800px) 100vw, 33vw', alt: article.title }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'cover-media' }}{%- endif -%}
            </div>
            <div class="journal-card__meta"><span>{{ article.published_at | date: '%Y.%m.%d' }}</span>{%- if article.tags.size > 0 -%}<span>{{ article.tags.first }}</span>{%- endif -%}</div>
            <h3 class="journal-card__title">{{ article.title }}</h3>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="journal-card"><div class="media journal-card__media">{{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'cover-media' }}</div><div class="journal-card__meta"><span>2026.11.01</span><span>News</span></div><h3 class="journal-card__title">{{ 'sections.journal.sample' | t }}</h3></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ジャーナル / News",
  "settings": [
    { "type": "blog", "id": "blog", "label": "ブログ" },
    { "type": "text", "id": "number", "label": "番号", "default": "(05)" },
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "Journal" },
    { "type": "text", "id": "title", "label": "見出し", "default": "News" },
    { "type": "text", "id": "link_label", "label": "リンクテキスト", "default": "All Articles" },
    { "type": "range", "id": "limit", "label": "表示数", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "ジャーナル / News" }]
}
{% endschema %}
