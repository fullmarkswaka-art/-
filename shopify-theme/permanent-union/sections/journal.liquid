{%- liquid
  assign s = section.settings
  assign blog = blogs[s.blog]
  assign fallbacks = 'pu-story-02.jpg,pu-story-05.jpg,pu-story-04.jpg' | split: ','
-%}
<section class="paper sec sec--journal" data-header="dark">
  <div class="container">
    <div class="sec__head">
      <div><h2 class="sec-h sec-h--s">{{ s.heading }}</h2><div class="sec-s">{{ s.sub }}</div></div>
      {%- if s.link_label != blank -%}<a class="more" href="{{ blog.url | default: '/blogs/journal' }}">{{ s.link_label }}　→</a>{%- endif -%}
    </div>
    <div class="jcards">
      {%- for article in blog.articles limit: 3 -%}
        <a class="jcard reveal" data-delay="{{ forloop.index0 }}" href="{{ article.url }}">
          <div class="jcard__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 100vw, 33vw', widths: '400, 800, 1200', alt: article.title, class: 'cover-img' }}
            {%- else -%}
              <img class="cover-img" src="{{ fallbacks[forloop.index0] | asset_url }}" alt="" loading="lazy" width="2000" height="1333">
            {%- endif -%}
          </div>
          <div class="jcard__meta">{{ article.published_at | date: '%Y.%m.%d' }}　{{ article.tags | first | upcase }}</div>
          <div class="jcard__t">{{ article.title }}</div>
        </a>
      {%- else -%}
        {%- assign samples = '2026-2027 FW コレクション 発売のお知らせ|NEWS,白馬のバックカントリーで、新作をテストする|RIDERS,長く使えること。PU SPECIALIZED 3 LAYER FABRIC|COLUMN' | split: ',' -%}
        {%- for smp in samples -%}
          {%- assign p = smp | split: '|' -%}
          <div class="jcard">
            <div class="jcard__media"><img class="cover-img" src="{{ fallbacks[forloop.index0] | asset_url }}" alt="" loading="lazy" width="2000" height="1333"></div>
            <div class="jcard__meta">2026.11.01　{{ p[1] }}</div>
            <div class="jcard__t">{{ p[0] }}</div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Journal（TOP）",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Journal" },
    { "type": "text", "id": "sub", "label": "和文小見出し", "default": "お知らせ・読みもの" },
    { "type": "blog", "id": "blog", "label": "ブログ", "info": "最新3件を表示。ブログが未作成の間はサンプルを表示" },
    { "type": "text", "id": "link_label", "label": "リンク文言", "default": "ALL ARTICLES" }
  ],
  "presets": [{ "name": "Journal（TOP）" }]
}
{% endschema %}
