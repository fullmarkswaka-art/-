{%- liquid
  comment
    商品詳細（上部）: 左ギャラリー／右 商品名・価格・カラー（大きいチップ）・サイズ（在庫状態つき）・数量・ADD TO CART・短い説明
    商品詳細（下部）: DESCRIPTION / SPEC / SIZE CHART / MORE ABOUT THIS ITEM（4つの導線）
    カート投入時のポップアップは使わず、右からカートドロワーを開く。
  endcomment
  assign s = section.settings
  assign current = product.selected_or_first_available_variant
  assign color_name = settings.color_option_name
  assign size_name = settings.size_option_name
  assign mf = product.metafields.custom
  assign short = mf.short_description
  if short == blank
    assign short = product.description | strip_html | truncate: 90, '…'
  endif
  assign main_collection = product.collections.first
  for c in product.collections
    unless c.handle == 'all' or c.handle == 'frontpage'
      assign main_collection = c
      break
    endunless
  endfor
  assign ajax = 'true'
  if settings.cart_type == 'page'
    assign ajax = 'false'
  endif
-%}
<section class="lp lp--product container" data-product data-header="dark">
  <script type="application/json" data-product-json>{{ product | json }}</script>
  <div class="crumb"><a href="{{ routes.root_url }}">HOME</a> ／ <a href="{{ routes.all_products_collection_url }}">PRODUCTS</a>{% if main_collection and main_collection.handle != 'all' %} ／ <a href="{{ main_collection.url }}">{{ main_collection.title | upcase }}</a>{% endif %} ／ {{ product.title | upcase }}</div>

  <div class="pd">
    <div class="pd__gallery" data-gallery>
      <div class="pd__main" data-gallery-main>
        {%- for media in product.media -%}
          <div class="pd__slide" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
                {{ media | image_url: width: 1800 | image_tag: loading: ld, sizes: '(max-width: 900px) 100vw, 45vw', widths: '600, 900, 1200, 1800', alt: media.alt | default: product.title, class: 'pd__img' }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, muted: true, playsinline: true, class: 'pd__img' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="pd__slide pd__slide--empty"><span>{{ 'products.product.no_image' | t }}</span></div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pd__thumbs" data-gallery-thumbs>
          {%- for media in product.media -%}
            <button type="button" class="pd__thumb{% if forloop.first %} is-on{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ forloop.index }}">
              {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
        <div class="pd__dots" data-gallery-dots aria-hidden="true">{% for media in product.media %}<span{% if forloop.first %} class="is-on"{% endif %}></span>{% endfor %}</div>
      {%- endif -%}
    </div>

    <div class="pd__info">
      <div class="lbl2">{{ product.vendor | upcase }}{% if main_collection and main_collection.handle != 'all' %} ／ {{ main_collection.title | upcase }}{% endif %}</div>
      <h1 class="pd__title">{{ product.title }}</h1>
      {%- if mf.subtitle != blank -%}<p class="pd__subtitle">{{ mf.subtitle }}</p>{%- endif -%}
      <div class="pd__price" data-price data-tax-label="{{ settings.tax_label }}">
        {%- if current.compare_at_price > current.price -%}<s class="pd__compare">{{ current.compare_at_price | money }}</s>{%- endif -%}
        <span class="pd__amount">{{ current.price | money }}</span><span class="pd__tax">{{ settings.tax_label }}</span>
      </div>
      <div class="hr"></div>

      {% form 'product', product, data-product-form: 'true', data-ajax-cart: ajax, class: 'pd__form' %}
        <input type="hidden" name="id" value="{{ current.id }}">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign is_color = false
              assign is_size = false
              if option.name == color_name
                assign is_color = true
              endif
              if option.name == size_name
                assign is_size = true
              endif
            -%}
            <fieldset class="opt opt--{% if is_color %}color{% elsif is_size %}size{% else %}other{% endif %}" data-option-index="{{ forloop.index0 }}">
              <legend class="lbl2 opt__legend">
                <span>{{ option.name | upcase }}　<b class="opt__value" data-option-value>{{ option.selected_value }}</b></span>
                {%- if is_size and settings.size_guide_url != blank -%}<a class="opt__guide" href="{{ settings.size_guide_url }}">{{ 'products.product.size_guide' | t }}</a>{%- endif -%}
              </legend>
              <div class="opt__values">
                {%- for value in option.values -%}
                  {%- assign id = 'opt-' | append: section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                  <input class="opt__input" type="radio" id="{{ id }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-input {% if value == option.selected_value %}checked{% endif %}>
                  {%- if is_color -%}
                    {%- assign hex = '#CFC6BA' -%}
                    {%- assign map_lines = settings.color_swatches | newline_to_br | split: '<br />' -%}
                    {%- for line in map_lines -%}{%- assign pair = line | strip | split: ':' -%}{%- assign k = pair[0] | strip | downcase -%}{%- assign v = value | downcase -%}{%- if k == v -%}{%- assign hex = pair[1] | strip -%}{%- endif -%}{%- endfor -%}
                    <label class="cbig" for="{{ id }}" title="{{ value | escape }}"><i style="background:{{ hex }}"></i><span>{{ value }}</span></label>
                  {%- else -%}
                    <label class="sz" for="{{ id }}" data-sz-label><span>{{ value }}</span><em class="sz__low" hidden>{{ 'products.product.low_stock' | t }}</em></label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="pd__buy">
          {%- if s.show_quantity -%}
            <div class="qty qty--l">
              <button type="button" data-qty-change="-1" aria-label="{{ 'sections.cart.decrease' | t }}">−</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" data-qty-change="1" aria-label="{{ 'sections.cart.increase' | t }}">＋</button>
            </div>
          {%- endif -%}
          <button type="submit" class="btn-d pd__add" data-add-button {% unless current.available %}disabled{% endunless %}>
            <span>{%- if current.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
            <em class="pd__add-price" data-add-price>{{ current.price | money }}</em>
          </button>
        </div>
        <p class="pd__stock" data-stock-msg hidden></p>
        {%- if s.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
      {% endform %}

      {%- if s.note != blank -%}<div class="pd__note">{{ s.note | newline_to_br }}</div>{%- endif -%}
      <div class="hr"></div>
      <div class="pd__short">{{ short }}</div>
    </div>
  </div>

  {%- comment -%} 下部: DESCRIPTION / SPEC / SIZE CHART / MORE ABOUT THIS ITEM {%- endcomment -%}
  <div class="pd2">
    <div class="pd2__col">
      <div class="lbl2">{{ 'products.product.description' | t }}</div>
      <div class="pd2__desc rte">{{ product.description }}</div>
      {%- assign has_spec = false -%}
      {%- if mf.material != blank or mf.waterproof != blank or mf.breathability != blank or mf.finish != blank or mf.features != blank or mf.weight != blank or mf.made_in != blank -%}{%- assign has_spec = true -%}{%- endif -%}
      {%- if has_spec or s.show_spec_always -%}
        <div class="lbl2 pd2__lbl">{{ 'products.product.spec' | t }}</div>
        <table class="spec">
          {%- if mf.material != blank -%}<tr><th>{{ 'products.product.material' | t }}</th><td>{{ mf.material }}</td></tr>{%- endif -%}
          {%- if mf.waterproof != blank -%}<tr><th>{{ 'products.product.waterproof' | t }}</th><td>{{ mf.waterproof }}</td></tr>{%- endif -%}
          {%- if mf.breathability != blank -%}<tr><th>{{ 'products.product.breathability' | t }}</th><td>{{ mf.breathability }}</td></tr>{%- endif -%}
          {%- if mf.finish != blank -%}<tr><th>{{ 'products.product.finish' | t }}</th><td>{{ mf.finish }}</td></tr>{%- endif -%}
          {%- if mf.weight != blank -%}<tr><th>{{ 'products.product.weight' | t }}</th><td>{{ mf.weight }}</td></tr>{%- endif -%}
          {%- if mf.made_in != blank -%}<tr><th>{{ 'products.product.made_in' | t }}</th><td>{{ mf.made_in }}</td></tr>{%- endif -%}
          {%- if mf.features != blank -%}<tr><th>{{ 'products.product.features' | t }}</th><td>{{ mf.features | newline_to_br }}</td></tr>{%- endif -%}
          {%- unless has_spec -%}<tr><th>{{ 'products.product.material' | t }}</th><td class="is-pending">—</td></tr>{%- endunless -%}
        </table>
      {%- endif -%}
    </div>
    <div class="pd2__col">
      {%- if s.show_size_chart -%}
        <div class="lbl2">{{ 'products.product.size_chart' | t }}</div>
        {%- if mf.size_chart != blank -%}
          <div class="sc-wrap rte">{{ mf.size_chart }}</div>
        {%- else -%}
          {%- assign size_opt = product.options_by_name[size_name] -%}
          <table class="sc">
            <tr><th></th>{% for v in size_opt.values %}<th>{{ v }}</th>{% endfor %}</tr>
            {%- assign rows = s.size_rows | newline_to_br | split: '<br />' -%}
            {%- for r in rows -%}<tr><th>{{ r | strip }}</th>{% for v in size_opt.values %}<td class="is-pending">—</td>{% endfor %}</tr>{%- endfor -%}
          </table>
          <p class="pd2__pending">{{ 'products.product.size_chart_pending' | t }}</p>
        {%- endif -%}
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="lbl2 pd2__lbl">{{ s.more_heading }}</div>
        <div class="navcards">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign url = b.link
              assign mfkey = b.metafield_key
              if mfkey != blank and mf[mfkey] != blank
                assign url = mf[mfkey]
              endif
              if b.use_size_guide and settings.size_guide_url != blank
                assign url = settings.size_guide_url
              endif
              if b.use_instagram and settings.social_instagram != blank
                assign url = settings.social_instagram
              endif
            -%}
            <a class="navcard" href="{{ url | default: '#' }}" {% if b.external %}target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
              <span class="navcard__a">{% if b.external %}↗{% else %}→{% endif %}</span>
              <div class="navcard__k">{{ b.kicker }}</div>
              <div class="navcard__t">{{ b.title }}</div>
              <div class="navcard__d">{{ b.text }}</div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} SP: 下部に追従する ADD TO CART {%- endcomment -%}
  <div class="pd__sticky" data-sticky-add aria-hidden="true">
    <button type="button" class="btn-d" data-sticky-button><span>{{ 'products.product.add_to_cart' | t }}</span><em data-add-price>{{ current.price | money }}</em></button>
  </div>
</section>
{% schema %}
{
  "name": "商品詳細",
  "settings": [
    { "type": "paragraph", "content": "カラー・サイズ・在庫をカートボタンの近くで直接選びます（ポップアップなし）。在庫は Ordify から同期された数で「残りわずか／在庫なし」を表示。しきい値は テーマ設定 > 商品。" },
    { "type": "checkbox", "id": "show_quantity", "label": "数量を表示", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "追加のチェックアウトボタン", "default": false },
    { "type": "textarea", "id": "note", "label": "カートボタン下の注記", "default": "在庫は店舗と連動して表示しています（在庫なし・残りわずか）\n送料・お届け日数はご利用ガイドに記載（仮）" },
    { "type": "header", "content": "下部" },
    { "type": "checkbox", "id": "show_spec_always", "label": "SPEC が未登録でも表を表示", "default": true },
    { "type": "checkbox", "id": "show_size_chart", "label": "SIZE CHART を表示", "default": true },
    { "type": "textarea", "id": "size_rows", "label": "サイズ表の項目（メタフィールド未登録時）", "default": "着丈\n身幅\n肩幅\n袖丈", "info": "数値はメタフィールド custom.size_chart（リッチテキスト／HTML表）に登録すると置き換わります" },
    { "type": "text", "id": "more_heading", "label": "導線の見出し", "default": "MORE ABOUT THIS ITEM" }
  ],
  "blocks": [
    { "type": "navcard", "name": "導線カード", "limit": 4, "settings": [
      { "type": "text", "id": "kicker", "label": "小見出し", "default": "01 COLUMN" },
      { "type": "text", "id": "title", "label": "タイトル", "default": "素材と技術" },
      { "type": "text", "id": "text", "label": "説明", "default": "PU SPECIALIZED 3 LAYER FABRIC の話" },
      { "type": "url", "id": "link", "label": "リンク先（共通）" },
      { "type": "text", "id": "metafield_key", "label": "商品ごとのリンク先メタフィールド（custom.〇〇 の 〇〇）", "info": "例: link_column。商品にこのメタフィールド（URL型）があればそちらを優先" },
      { "type": "checkbox", "id": "use_size_guide", "label": "テーマ設定のサイズガイドURLを使う", "default": false },
      { "type": "checkbox", "id": "use_instagram", "label": "テーマ設定の Instagram URL を使う", "default": false },
      { "type": "checkbox", "id": "external", "label": "別タブで開く（↗）", "default": false }
    ] }
  ],
  "default": { "blocks": [
    { "type": "navcard", "settings": { "kicker": "01 COLUMN", "title": "素材と技術", "text": "PU SPECIALIZED 3 LAYER FABRIC の話", "metafield_key": "link_column" } },
    { "type": "navcard", "settings": { "kicker": "02 SIZE GUIDE", "title": "サイズの選び方", "text": "着用サイズの目安・測り方", "use_size_guide": true } },
    { "type": "navcard", "settings": { "kicker": "03 RIDERS", "title": "ライダーの着用", "text": "フィールドでの着用写真・声", "link": "/pages/riders", "metafield_key": "link_riders" } },
    { "type": "navcard", "settings": { "kicker": "04 INSTAGRAM", "title": "スタイリング", "text": "@permanentunion の投稿へ", "use_instagram": true, "external": true } }
  ] }
}
{% endschema %}
