{% layout none %}
{%- assign gc_value = gift_card.initial_value | money -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_cards.issued.title' | t: value: gc_value, shop: shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="container container--narrow section text-center">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="display mt-2">{{ 'gift_cards.issued.subtext' | t }}</h1>
    <p class="h1 mt-4">{{ gc_value }}</p>
    {%- if gift_card.enabled == false or gift_card.expired -%}<p class="muted">{{ 'gift_cards.issued.expired' | t }}</p>{%- endif -%}
    <p class="mt-3 sans" style="font-size:22px;letter-spacing:.2em">{{ gift_card.code | format_code }}</p>
    <a class="button mt-4" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
  </main>
</body>
</html>
