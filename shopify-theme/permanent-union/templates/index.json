    "story1": { "type": "story", "settings": {
      "chapter": 1, "color_name": "Muku", "layout": "vt-right", "focal_y": 34, "focal_x_sp": 58, "dim": 30,
      "vt_text": "森に抱かれ、山で遊ぶ時間は、\n私たちにとって至福のものです。",
      "en": "Held by the forest, let loose in the mountains—\nthis is our kind of bliss."
    } },
    "story2": { "type": "story", "settings": {
      "chapter": 2, "color_name": "Kakishibu", "layout": "bottom", "focal_x_sp": 66, "dim": 35,
      "vt_text": "", "heading": "だからこそ", "sub": "（例えばデートに出かけるときのように）",
      "en": "Which is why I choose outerwear that's true to who I am"
    } },
    "story3": { "type": "story", "settings": {
      "chapter": 3, "color_name": "Wakaba", "layout": "vt-left", "focal_y": 30, "dim": 30,
      "vt_text": "自分らしいウェアを\n身に纏いたいのです。",
      "en": "- Just like I would when heading out on a date."
    } },
    "interlude1": { "type": "interlude", "settings": { "height": 70 } },
    "story4": { "type": "story", "settings": {
      "chapter": 4, "color_name": "Slate Blue", "layout": "block-l", "focal_x_sp": 70, "dim": 50,
      "vt_text": "", "label": "Sustainability",
      "heading": "私たちが考える環境への配慮は、\n長く使えること。",
      "heading_sp": "私たちが考える\n環境への配慮は、\n長く使えること。",
      "sub": "そのために日本の山に必要な撥水性能と、\nタフな使用でも耐え得る強い生地を開発しました。",
      "en": "We believe sustainability starts with making things that last. Engineered for Japan's demanding mountain conditions, our fabric delivers the water repellency and durability to perform wherever the mountains take you."
    } },
    "story5": { "type": "story", "settings": {
      "chapter": 5, "color_name": "Muku", "layout": "block-r", "focal_y": 60, "dim": 40,
      "vt_text": "", "label": "Clothing is in our DNA",
      "heading": "Permanent Unionの\nものづくりはあくまで洋服。",
      "sub": "縫製の仕方、革の採用、\nスポーツウェアにはないオリジナリティをインプットしています。",
      "en": "Clothing is in our DNA. From construction and stitching to our choice of leather materials, details drawn from garment design are woven throughout—bringing a character rarely seen in conventional sportswear."
    } },
    "story6": { "type": "story", "settings": {
      "chapter": 6, "color_name": "Midnight", "layout": "vt-sub", "focal_y": 20, "focal_x_sp": 100, "focal_y_sp": 30, "dim": 35,
      "vt_text": "受け継いだ羊毛を、\n新しい温もりに。", "sub": "― 古着から作り出す再生ウール ―", "label": "Recycled wool",
      "en": "Passing warmth from one life to the next.\n- Recycled wool made from used garments. -"
    } },
    "interlude2": { "type": "interlude", "settings": { "height": 70 } },
    "story7": { "type": "story", "settings": {
      "chapter": 7, "color_name": "Midnight", "layout": "center", "focal_y": 40, "dim": 50,
      "vt_text": "", "heading": "山へ　街へ　その先へ",
      "sub": "行き先を選ばない洋服で\n旅をもっと日常に、日常をもっと自由に。",
      "en": "From the mountains to the city— and anywhere in between.\nClothing without boundaries.\nMake travel part of the everyday. Make the everyday feel more free.",
      "button_label": "ONLINE STORE", "button_link": "/collections/all"
    } },
