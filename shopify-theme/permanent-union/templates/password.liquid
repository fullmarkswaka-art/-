{% layout 'password' %}
<p class="eyebrow">{{ shop.name }}</p>
<h1 class="display">Be Awesome In The Mountain</h1>
<p class="lead">{{ 'general.password_page.opening_soon' | t }}</p>
{%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
{% form 'storefront_password', class: 'password-form' %}
  {{ form.errors | default_errors }}
  <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
  <input type="password" name="password" id="Password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
  <button type="submit" class="button button--light">{{ 'general.password_page.login_form_submit' | t }}</button>
{% endform %}
