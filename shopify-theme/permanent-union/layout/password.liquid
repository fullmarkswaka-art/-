<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  {%- if settings.load_google_fonts -%}
    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;500&family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&family=Noto+Sans+JP:wght@300;400;500&display=swap" rel="stylesheet">
  {%- endif -%}
  {% style %}
    :root {
      --paper: {{ settings.color_paper }}; --paper2: {{ settings.color_paper2 }}; --ink: {{ settings.color_ink }}; --brown: {{ settings.color_brown }};
      --text: {{ settings.color_text }}; --muted: {{ settings.color_muted }}; --muted2: #7E726A; --line: {{ settings.color_line }}; --accent: {{ settings.color_accent }};
      --jp: "Shippori Mincho B1", serif; --cg: "Cormorant Garamond", serif; --en: "Jost", sans-serif; --ui: "Noto Sans JP", sans-serif;
      --gutter: clamp(20px, 5.8vw, 84px); --header-h: 110px; --logo-w: 158px; --logo-w-sp: 112px;
    }
  {% endstyle %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main class="password-page">
    <div class="password-page__bg">
      {%- if settings.password_image != blank -%}
        {{ settings.password_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'cover-img' }}
      {%- else -%}
        <img src="{{ 'pu-bg-still.jpg' | asset_url }}" alt="" class="cover-img" width="2560" height="1707">
      {%- endif -%}
      <div class="password-page__dim"></div>
    </div>
    <div class="password-page__inner">
      {% render 'logo', color: 'white', class: 'password-page__logo', width: 800 %}
      {{ content_for_layout }}
    </div>
  </main>
</body>
</html>
