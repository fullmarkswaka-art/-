{%- comment -%}
  商品カード（muraco 型のシンプルな一覧・ホバー演出なし）
  render 'product-card', product: product, index: forloop.index0
{%- endcomment -%}
{%- liquid
  assign img = product.featured_media
  assign is_new = false
  if settings.new_tag != blank and product.tags contains settings.new_tag
    assign is_new = true
  endif
  if settings.new_days > 0
    assign limit_sec = settings.new_days | times: 86400
    assign age = 'now' | date: '%s' | minus: 0
    assign pub = product.published_at | date: '%s' | minus: 0
    assign diff = age | minus: pub
    if diff < limit_sec
      assign is_new = true
    endif
  endif
-%}
<a href="{{ product.url }}" class="card">
  <div class="card__ph{% unless img %} card__ph--empty{% endunless %}">
    {%- if img -%}
      {{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 50vw, 25vw', widths: '300, 450, 600, 900', alt: product.title, class: 'card__img' }}
    {%- else -%}
      <span>{{ 'products.product.no_image' | t }}</span>
    {%- endif -%}
    {%- if product.available == false -%}
      <span class="badge badge--out">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="badge">{{ 'products.product.on_sale' | t }}</span>
    {%- elsif is_new -%}
      <span class="badge">{{ 'products.product.new' | t }}</span>
    {%- endif -%}
  </div>
  <div class="card__nm">{{ product.title }}</div>
  <div class="card__pr">{{ product.price | money }}{{ settings.tax_label }}</div>
  <div class="card__cc">{% render 'swatches', product: product, size: 'small' %}</div>
</a>
